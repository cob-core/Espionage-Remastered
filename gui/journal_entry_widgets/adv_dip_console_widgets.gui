### ESPIONAGE CONSOLE - Espionage Remastered
### Hosted on the Shadow War journal entry (custom_widget_container_1).
### Layout rules: flowcontainers only (no hbox/vbox children), never set a size
### on a container - fixedgridbox cells bound and clip each row instead.
### Data rules: no Var/GetVariable promotes (dead at GUI runtime) - variable
### pairing goes through script-side predicate SGUIs instead.

types adv_dip_console_types
{
	### Character row: clickable portrait, name, detail line, traits, buttons.
	type adv_dip_character_row = flowcontainer {
		direction = horizontal
		spacing = 8
		margin_left = 10
		margin_right = 10

		background = {
			using = entry_bg_simple
			alpha = 0.5
		}

		button = {
			parentanchor = vcenter
			size = { 40 40 }
			onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
			onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
			tooltip = "GO_TO_BUTTON_CHARACTER"
			using = tooltip_ne

			character_portrait_small = {}
		}

		flowcontainer = {
			parentanchor = vcenter
			direction = vertical

			textbox = {
				size = { 220 20 }
				text = "[Character.GetFullNameNoFormatting]"
				default_format = "#v"
				align = left|nobaseline
				elide = right
				using = fontsize_medium
			}

			block "detail_line" {
				textbox = {
					size = { 220 16 }
					text = "[Character.GetCulture.GetName]"
					align = left|nobaseline
					elide = right
					using = fontsize_small
				}
			}
		}

		widget = {
			parentanchor = vcenter
			size = { 180 52 }
			scissor = yes

			character_traits_no_label = {
				parentanchor = left|vcenter
			}
		}

		block "row_action" {}
	}

	### Operation row: target flag/name/cost natively from the country context,
	### the assigned agent's portrait matched through a predicate SGUI.
	type adv_dip_operation_row = flowcontainer {
		direction = horizontal
		spacing = 8
		margin_left = 10
		margin_right = 10

		background = {
			using = entry_bg_simple
			alpha = 0.5
		}

		small_flag = {
			parentanchor = vcenter
		}

		flowcontainer = {
			parentanchor = vcenter
			direction = vertical

			textbox = {
				size = { 260 20 }
				text = "[Country.GetName]"
				default_format = "#v"
				align = left|nobaseline
				elide = right
				using = fontsize_medium
			}

			block "op_label" {}
		}

		block "agent_portrait" {}

		block "op_cost" {}

		block "cancel_button" {}
	}
}

flowcontainer = {
	name = "widget_adv_dip_console"
	direction = vertical
	spacing = 6
	ignoreinvisible = yes

	### AGENCY BUDGET
	flowcontainer = {
		direction = horizontal
		spacing = 8
		margin_left = 10
		margin_top = 4

		background = {
			using = entry_bg_simple
			alpha = 0.5
		}

		textbox = {
			parentanchor = vcenter
			size = { 300 24 }
			text = "ADV_DIP_CONSOLE_BUDGET_LABEL"
			align = left|nobaseline
			using = fontsize_medium
		}

		textbox = {
			parentanchor = vcenter
			size = { 190 24 }
			raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_monthly_espionage_spend')|0]/month#!"
			align = right|nobaseline
			using = fontsize_medium
			tooltip = "ADV_DIP_CONSOLE_BUDGET_TT"
			using = tooltip_ne
		}
	}

	### DIRECTOR OF INTELLIGENCE
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_DIRECTOR"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_director_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('adv_dip_director_toggle')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			}
		}

		empty_state = {
			blockoverride "visible" {
				visible = "[And( Not(GetVariableSystem.Exists('adv_dip_director_toggle')), IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_director')) )]"
			}
			blockoverride "text" {
				text = "ADV_DIP_CONSOLE_NO_DIRECTOR"
			}
		}

		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_director')]"
			addcolumn = 520
			addrow = 62

			item = {
				adv_dip_character_row = {
					datacontext = "[Scope.AccessCharacter]"

					blockoverride "detail_line" {
						textbox = {
							size = { 130 16 }
							text = "ADV_DIP_CONSOLE_DIRECTOR_ROLE"
							default_format = "#P"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 86 16 }
							raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_wage_director')|0]/mo#!"
							align = left|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_WAGE_TT"
							using = tooltip_ne
						}
					}

					blockoverride "row_action" {
						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_dismiss_director').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_dismiss_director').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_dismiss_director').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_dismiss_director').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			direction = horizontal
			margin_left = 10
			margin_top = 6
			margin_bottom = 8

			button = {
				size = { 280 34 }
				using = default_button_action
				using = tooltip_above
				visible = "[GetScriptedGui('adv_dip_sgui_recruit_director').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				enabled = "[GetScriptedGui('adv_dip_sgui_recruit_director').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				onclick = "[GetScriptedGui('adv_dip_sgui_recruit_director').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				tooltip = "[GetScriptedGui('adv_dip_sgui_recruit_director').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"

				flowcontainer = {
					parentanchor = center
					spacing = 6

					icon = {
						parentanchor = vcenter
						size = { 22 22 }
						texture = "gfx/interface/buttons/button_icons/plus.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 230
						text = "ADV_DIP_CONSOLE_RECRUIT_DIRECTOR"
						align = nobaseline
						using = fontsize_medium
					}
				}
			}
		}
	}

	### OPERATIVES
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_OPERATIVES"
			}
			blockoverride "right_text" {
				section_header_right_text = {
					raw_text = "#v [GetDataModelSize(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives'))]#!"
				}
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_operatives_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('adv_dip_operatives_toggle')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			}
		}

		empty_state = {
			blockoverride "visible" {
				visible = "[And( Not(GetVariableSystem.Exists('adv_dip_operatives_toggle')), IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives')) )]"
			}
			blockoverride "text" {
				text = "ADV_DIP_CONSOLE_NO_OPERATIVES"
			}
		}

		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives')]"
			addcolumn = 520
			addrow = 62

			item = {
				adv_dip_character_row = {
					datacontext = "[Scope.AccessCharacter]"

					blockoverride "detail_line" {
						textbox = {
							size = { 82 16 }
							visible = "[And( Not(Character.IsBusy), Not(GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)) )]"
							text = "ADV_DIP_CONSOLE_STATUS_AVAILABLE"
							default_format = "#P"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 82 16 }
							visible = "[And( Character.IsBusy, Not(GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)) )]"
							text = "ADV_DIP_CONSOLE_STATUS_ON_MISSION"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 82 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							text = "ADV_DIP_CONSOLE_STATUS_CAPTURED"
							default_format = "#N"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 62 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_seasoned').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							text = "adv_dip_seasoned"
							align = left|nobaseline
							elide = right
							using = fontsize_small
							tooltip = "adv_dip_seasoned_desc"
							using = tooltip_ne
						}
						textbox = {
							size = { 62 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_veteran').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							text = "adv_dip_veteran"
							align = left|nobaseline
							elide = right
							using = fontsize_small
							tooltip = "adv_dip_veteran_desc"
							using = tooltip_ne
						}
						textbox = {
							size = { 62 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_master').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							text = "adv_dip_master_spy"
							align = left|nobaseline
							elide = right
							using = fontsize_small
							tooltip = "adv_dip_master_spy_desc"
							using = tooltip_ne
						}
						textbox = {
							size = { 70 16 }
							visible = "[Not(Or( GetScriptedGui('adv_dip_sgui_tier_seasoned').IsValid(GuiScope.SetRoot(Character.MakeScope).End), Or( GetScriptedGui('adv_dip_sgui_tier_veteran').IsValid(GuiScope.SetRoot(Character.MakeScope).End), GetScriptedGui('adv_dip_sgui_tier_master').IsValid(GuiScope.SetRoot(Character.MakeScope).End) ) ))]"
							raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_wage_base')|0]/mo#!"
							align = left|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_WAGE_TT"
							using = tooltip_ne
						}
						textbox = {
							size = { 70 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_seasoned').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_wage_seasoned')|0]/mo#!"
							align = left|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_WAGE_TT"
							using = tooltip_ne
						}
						textbox = {
							size = { 70 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_veteran').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_wage_veteran')|0]/mo#!"
							align = left|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_WAGE_TT"
							using = tooltip_ne
						}
						textbox = {
							size = { 70 16 }
							visible = "[GetScriptedGui('adv_dip_sgui_tier_master').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							raw_text = "#v £[JournalEntry.GetCountry.MakeScope.ScriptValue('adv_dip_wage_master')|0]/mo#!"
							align = left|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_WAGE_TT"
							using = tooltip_ne
						}
					}

					blockoverride "row_action" {
						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			direction = horizontal
			margin_left = 10
			margin_top = 6
			margin_bottom = 8

			button = {
				size = { 240 34 }
				using = default_button_action
				using = tooltip_above
				visible = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				enabled = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				onclick = "[GetScriptedGui('adv_dip_sgui_recruit_operative').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				tooltip = "[GetScriptedGui('adv_dip_sgui_recruit_operative').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"

				flowcontainer = {
					parentanchor = center
					spacing = 6

					icon = {
						parentanchor = vcenter
						size = { 22 22 }
						texture = "gfx/interface/buttons/button_icons/plus.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 190
						text = "ADV_DIP_CONSOLE_RECRUIT"
						align = nobaseline
						using = fontsize_medium
					}
				}
			}
		}
	}

	### PENDING ELECTION BALLOTS
	flowcontainer = {
		direction = vertical
		visible = "[Not(IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_election_choice')))]"

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		textbox = {
			size = { 520 30 }
			text = "ADV_DIP_CONSOLE_BALLOT"
			align = left|nobaseline
			margin_left = 10
			using = fontsize_medium
		}

		flowcontainer = {
			direction = vertical
			spacing = 4
			margin_bottom = 8
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_election_choice')]"

			item = {
				flowcontainer = {
					direction = vertical
					datacontext = "[Scope.GetCountry]"

					flowcontainer = {
						direction = horizontal
						spacing = 8
						margin_left = 10

						small_flag = {
							parentanchor = vcenter
						}

						textbox = {
							parentanchor = vcenter
							size = { 260 22 }
							text = "[Country.GetName]"
							default_format = "#v"
							align = left|nobaseline
							elide = right
							using = fontsize_medium
						}

						textbox = {
							parentanchor = vcenter
							size = { 170 18 }
							text = "ADV_DIP_CONSOLE_BALLOT_HINT"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
					}

					flowcontainer = {
						direction = vertical
						spacing = 2
						margin_left = 40
						datamodel = "[Country.AccessActiveParties]"

						item = {
							flowcontainer = {
								direction = horizontal
								spacing = 8

								background = {
									using = entry_bg_simple
									alpha = 0.4
								}

								textbox = {
									parentanchor = vcenter
									size = { 330 22 }
									text = "[Party.GetName]"
									align = left|nobaseline
									elide = right
									using = fontsize_small
								}

								button_icon_check = {
									parentanchor = vcenter
									size = { 24 24 }
									visible = "[GetScriptedGui('adv_dip_sgui_back_party').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('target', Country.MakeScope).AddScope('party', Party.MakeScope).End)]"
									enabled = "[GetScriptedGui('adv_dip_sgui_back_party').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('target', Country.MakeScope).AddScope('party', Party.MakeScope).End)]"
									onclick = "[GetScriptedGui('adv_dip_sgui_back_party').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('target', Country.MakeScope).AddScope('party', Party.MakeScope).End)]"
									tooltip = "[GetScriptedGui('adv_dip_sgui_back_party').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('target', Country.MakeScope).AddScope('party', Party.MakeScope).End)]"
									using = tooltip_ne
								}
							}
						}
					}
				}
			}
		}
	}

	### ACTIVE OPERATIONS
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_OPERATIONS"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_ops_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('adv_dip_ops_toggle')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_ops_toggle'))]"
			}
		}

		empty_state = {
			blockoverride "visible" {
				visible = "[And( Not(GetVariableSystem.Exists('adv_dip_ops_toggle')), Not(GetScriptedGui('adv_dip_sgui_has_operations').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)) )]"
			}
			blockoverride "text" {
				text = "ADV_DIP_CONSOLE_NO_OPERATIONS"
			}
		}

		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_ops_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_op_sow_discontent')]"
			addcolumn = 520
			addrow = 48

			item = {
				adv_dip_operation_row = {
					datacontext = "[Scope.GetCountry]"

					blockoverride "op_label" {
						textbox = {
							size = { 260 18 }
							text = "sow_discontent_action_name"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
					}

					blockoverride "agent_portrait" {
						flowcontainer = {
							parentanchor = vcenter
							ignoreinvisible = yes
							datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_agents_sow_discontent')]"

							item = {
								widget = {
									size = { 36 36 }
									visible = "[GetScriptedGui('adv_dip_sgui_agent_matches').IsValid(GuiScope.SetRoot(Country.MakeScope).AddScope('agent', Scope.GetCharacter.MakeScope).End)]"

									button = {
										size = { 36 36 }
										datacontext = "[Scope.AccessCharacter]"
										onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
										onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
										tooltip = "ADV_DIP_CONSOLE_AGENT_TT"
										using = tooltip_ne

										character_portrait_mini = {}
									}
								}
							}
						}
					}

					blockoverride "op_cost" {
						textbox = {
							size = { 80 20 }
							raw_text = "#v £[Country.MakeScope.ScriptValue('adv_dip_upkeep_medium_display')|0]/mo#!"
							align = right|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_OP_COST_TT"
							using = tooltip_ne
						}
					}

					blockoverride "cancel_button" {
						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_cancel_sow_discontent').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_cancel_sow_discontent').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_cancel_sow_discontent').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_cancel_sow_discontent').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}
		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_ops_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_op_support_nationalists')]"
			addcolumn = 520
			addrow = 48

			item = {
				adv_dip_operation_row = {
					datacontext = "[Scope.GetCountry]"

					blockoverride "op_label" {
						textbox = {
							size = { 260 18 }
							text = "support_nationalists_action_name"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
