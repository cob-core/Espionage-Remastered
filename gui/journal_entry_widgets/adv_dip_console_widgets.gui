### ESPIONAGE CONSOLE - Espionage Remastered
### Hosted on the Shadow War journal entry (custom_widget_container_1).
### Layout rule: flowcontainers only, never hbox/vbox as a flowcontainer child.

types adv_dip_console_types
{
	### Character row: clickable portrait, name, subtitle, action buttons.
	### Portrait handlers need an Access datacontext (Scope.AccessCharacter).
	type adv_dip_character_row = flowcontainer {
		direction = horizontal
		spacing = 8
		margin_left = 10
		margin_right = 10

		background = {
			using = entry_bg_simple
			alpha = 0.5
		}

		button = {
			parentanchor = vcenter
			size = { 40 40 }
			onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
			onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
			tooltip = "GO_TO_BUTTON_CHARACTER"
			using = tooltip_ne

			character_portrait_small = {}
		}

		flowcontainer = {
			parentanchor = vcenter
			direction = vertical

			textbox = {
				size = { 250 22 }
				text = "[Character.GetFullNameNoFormatting]"
				default_format = "#v"
				align = left|nobaseline
				elide = right
				using = fontsize_medium
			}

			block "subtitle" {
				textbox = {
					size = { 250 18 }
					text = "[Character.GetCulture.GetName]"
					align = left|nobaseline
					elide = right
					using = fontsize_small
				}
			}
		}

		character_traits_no_label = {
			parentanchor = vcenter
		}

		block "row_action" {}
	}

	### Operation row: target flag and name, operation label, cancel button.
	type adv_dip_operation_row = flowcontainer {
		direction = horizontal
		spacing = 8
		margin_left = 10
		margin_right = 10

		background = {
			using = entry_bg_simple
			alpha = 0.5
		}

		small_flag = {
			parentanchor = vcenter
		}

		flowcontainer = {
			parentanchor = vcenter
			direction = vertical

			textbox = {
				size = { 250 22 }
				text = "[Country.GetName]"
				default_format = "#v"
				align = left|nobaseline
				elide = right
				using = fontsize_medium
			}

			block "op_label" {}
		}

		block "cancel_button" {}
	}
}

flowcontainer = {
	name = "widget_adv_dip_console"
	direction = vertical
	spacing = 6
	ignoreinvisible = yes

	### DIRECTOR OF INTELLIGENCE
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_DIRECTOR"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_director_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('adv_dip_director_toggle')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			direction = vertical
			spacing = 4
			margin_top = 5
			margin_bottom = 8
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_director')]"

			empty_state = {
				blockoverride "visible" {
					visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_director'))]"
				}
				blockoverride "text" {
					text = "ADV_DIP_CONSOLE_NO_DIRECTOR"
				}
			}

			item = {
				adv_dip_character_row = {
					datacontext = "[Scope.AccessCharacter]"

					blockoverride "subtitle" {
						textbox = {
							size = { 250 18 }
							text = "ADV_DIP_CONSOLE_DIRECTOR_ROLE"
							default_format = "#P"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
					}

					blockoverride "row_action" {
						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_dismiss_director').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_dismiss_director').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_dismiss_director').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_dismiss_director').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}
	}

	### OPERATIVES
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_OPERATIVES"
			}
			blockoverride "right_text" {
				section_header_right_text = {
					raw_text = "#v [GetDataModelSize(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives'))]#!"
				}
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_operatives_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('adv_dip_operatives_toggle')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			direction = vertical
			spacing = 4
			margin_top = 5
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives')]"

			empty_state = {
				blockoverride "visible" {
					visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives'))]"
				}
				blockoverride "text" {
					text = "ADV_DIP_CONSOLE_NO_OPERATIVES"
				}
			}

			item = {
				adv_dip_character_row = {
					datacontext = "[Scope.AccessCharacter]"

					blockoverride "subtitle" {
						textbox = {
							size = { 250 18 }
							visible = "[And( Not(Character.IsBusy), Not(GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)) )]"
							text = "ADV_DIP_CONSOLE_STATUS_AVAILABLE"
							default_format = "#P"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 250 18 }
							visible = "[And( Character.IsBusy, Not(GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)) )]"
							text = "ADV_DIP_CONSOLE_STATUS_ON_MISSION"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
						textbox = {
							size = { 250 18 }
							visible = "[GetScriptedGui('adv_dip_sgui_operative_captured').IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
							text = "ADV_DIP_CONSOLE_STATUS_CAPTURED"
							default_format = "#N"
							align = left|nobaseline
							elide = right
							using = fontsize_small
						}
					}

					blockoverride "row_action" {
						button = {
							parentanchor = vcenter
							size = { 110 28 }
							using = default_button_action
							using = tooltip_ne
							visible = "[GetScriptedGui('adv_dip_sgui_appoint_director').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_appoint_director').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_appoint_director').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_appoint_director').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"

							textbox = {
								parentanchor = center
								autoresize = yes
								max_width = 98
								text = "ADV_DIP_CONSOLE_APPOINT"
								align = center|nobaseline
								elide = right
								using = fontsize_small
							}
						}

						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_dismiss_operative').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			direction = horizontal
			margin_left = 10
			margin_top = 6
			margin_bottom = 8

			button = {
				size = { 240 34 }
				using = default_button_action
				using = tooltip_above
				visible = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				enabled = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				onclick = "[GetScriptedGui('adv_dip_sgui_recruit_operative').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				tooltip = "[GetScriptedGui('adv_dip_sgui_recruit_operative').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"

				flowcontainer = {
					parentanchor = center
					spacing = 6

					icon = {
						parentanchor = vcenter
						size = { 22 22 }
						texture = "gfx/interface/buttons/button_icons/plus.dds"
					}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 190
						text = "ADV_DIP_CONSOLE_RECRUIT"
						align = nobaseline
						elide = right
						using = fontsize_medium
					}
				}
			}
		}
	}

	### ACTIVE OPERATIONS
	flowcontainer = {
		direction = vertical

		background = {
			using = dropdown_background
			margin = { 0 -2 }
		}

		section_header_button = {
