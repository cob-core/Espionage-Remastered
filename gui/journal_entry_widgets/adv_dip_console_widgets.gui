		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_ops_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_agents_agitate_for_liberty')]"
			addcolumn = 520
			addrow = 44
			datamodel_wrap = 1

			item = {
