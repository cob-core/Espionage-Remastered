		fixedgridbox = {
			visible = "[Not(GetVariableSystem.Exists('adv_dip_ops_toggle'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_agents_steal_technology')]"
			addcolumn = 520
			addrow = 44
			datamodel_wrap = 1

			item = {
				adv_dip_operation_row = {
					datacontext = "[Scope.AccessCharacter]"

					blockoverride "op_label" {
						textbox = {
							size = { 150 16 }
							text = "steal_technology_action_name"
							align = left|nobaseline
