### ESPIONAGE CONSOLE — Espionage Remastered
flowcontainer = {
	name = "widget_adv_dip_console"
	direction = vertical
	spacing = 4
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_DIRECTOR"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_director_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_director_toggle'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('adv_dip_director_toggle')]"
			}
		}

		fixedgridbox = {
			visible = "[GetVariableSystem.Exists('adv_dip_director_toggle')]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_director')]"
			addcolumn = 500
			addrow = 34
			datamodel_wrap = 1

			item = {
				flowcontainer = {
					datacontext = "[Scope.GetCharacter]"
					direction = horizontal
					spacing = 8
					margin_left = 10

					textbox = {
						size = { 460 30 }
						text = "[Character.GetFullNameNoFormatting]"
						align = left|nobaseline
						using = fontsize_medium
					}
				}
			}
		}

		fixedgridbox = {
			visible = "[GetVariableSystem.Exists('adv_dip_director_toggle')]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives')]"
			addcolumn = 500
			addrow = 30
			datamodel_wrap = 1

			item = {
				flowcontainer = {
					datacontext = "[Scope.GetCharacter]"
					direction = horizontal
					spacing = 6
					margin_left = 10

					textbox = {
						size = { 330 26 }
						text = "[Character.GetFullNameNoFormatting]"
						align = left|nobaseline
						using = fontsize_small
					}

					button = {
							size = { 110 26 }
							using = default_button_action
							visible = "[GetScriptedGui('adv_dip_sgui_appoint_director').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_appoint_director').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_appoint_director').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_appoint_director').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('candidate', Scope.GetCharacter.MakeScope).End)]"

							textbox = {
								parentanchor = center
								autoresize = yes
								max_width = 98
								text = "ADV_DIP_CONSOLE_APPOINT"
								align = center|nobaseline
								using = fontsize_small
							}
						}
				}
			}
		}
	}

	flowcontainer = {
		direction = vertical

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "ADV_DIP_CONSOLE_OPERATIVES"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('adv_dip_operatives_toggle')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('adv_dip_operatives_toggle'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('adv_dip_operatives_toggle')]"
			}
		}

		fixedgridbox = {
			visible = "[GetVariableSystem.Exists('adv_dip_operatives_toggle')]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('adv_dip_operatives')]"
			addcolumn = 500
			addrow = 30
			datamodel_wrap = 1

			item = {
				flowcontainer = {
					datacontext = "[Scope.GetCharacter]"
					direction = horizontal
					spacing = 6
					margin_left = 10

					textbox = {
						size = { 300 26 }
						text = "[Character.GetFullNameNoFormatting]"
						align = left|nobaseline
						using = fontsize_small
					}

					textbox = {
						size = { 150 26 }
						text = "[Character.GetCulture.GetName]"
						align = left|nobaseline
						using = fontsize_small
					}
				}
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists('adv_dip_operatives_toggle')]"
			direction = horizontal
			margin_left = 10

			button = {
							size = { 240 30 }
							using = default_button_action
							visible = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_recruit_operative').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_recruit_operative').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_recruit_operative').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"

							textbox = {
								parentanchor = center
								autoresize = yes
								max_width = 228
								text = "ADV_DIP_CONSOLE_RECRUIT"
								align = center|nobaseline
								using = fontsize_small
							}
						}
		}
	}

