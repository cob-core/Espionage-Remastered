						textbox = {
							size = { 80 20 }
							raw_text = "#v £[Country.MakeScope.ScriptValue('adv_dip_upkeep_small_display')|0]/mo#!"
							align = right|nobaseline
							using = fontsize_small
							tooltip = "ADV_DIP_CONSOLE_OP_COST_TT"
							using = tooltip_ne
						}
					}

					blockoverride "cancel_button" {
						button_icon_cancel = {
							parentanchor = vcenter
							size = { 26 26 }
							visible = "[GetScriptedGui('adv_dip_sgui_cancel_support_slaves').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							enabled = "[GetScriptedGui('adv_dip_sgui_cancel_support_slaves').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							onclick = "[GetScriptedGui('adv_dip_sgui_cancel_support_slaves').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							tooltip = "[GetScriptedGui('adv_dip_sgui_cancel_support_slaves').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope('op_target', Scope.GetCountry.MakeScope).End)]"
							using = tooltip_ne
						}
					}
				}
			}
		}
	}
}
